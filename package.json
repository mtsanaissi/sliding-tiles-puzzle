{
  "name": "sliding-ui-puzzle-workspace",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @mtsanaissi/sliding-ui-puzzle-demo dev",
    "dev:demo": "pnpm --filter @mtsanaissi/sliding-ui-puzzle-demo dev",
    "build": "pnpm -r --if-present build",
    "preview": "pnpm --filter @mtsanaissi/sliding-ui-puzzle-demo preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}

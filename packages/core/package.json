{
  "name": "@mtsanaissi/sliding-ui-puzzle-core",
  "version": "0.2.0",
  "description": "Framework-agnostic sliding puzzle engine for board state, solvable scrambling, and move logic.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "sliding-puzzle",
    "puzzle",
    "typescript",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtsanaissi/sliding-tiles-puzzle.git"
  },
  "homepage": "https://github.com/mtsanaissi/sliding-tiles-puzzle",
  "bugs": {
    "url": "https://github.com/mtsanaissi/sliding-tiles-puzzle/issues"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  }
}
